global function ReMap_Init
global function ReMap_Clear
global function ReMap_CreateProp
global function ReMap_ClearZiplines
global function ReMap_CreateZipline

global const int REMAP_ZIPLINE_END_NONE = 0
global const int REMAP_ZIPLINE_END_ARM = 1
global const int REMAP_ZIPLINE_END_SUPPORT = 2
global const int REMAP_ZIPLINE_END_PANEL_WALL = 3
global const int REMAP_ZIPLINE_END_PANEL_STAND = 4

const asset REMAP_ZIPLINE_MODEL_ARM = $"mdl/industrial/zipline_arm.rmdl"
const asset REMAP_ZIPLINE_MODEL_SUPPORT = $"mdl/industrial/security_fence_post.rmdl"
const asset REMAP_ZIPLINE_MODEL_PANEL_WALL = $"mdl/props/global_access_panel_button/global_access_panel_button_wall.rmdl"
const asset REMAP_ZIPLINE_MODEL_PANEL_STAND = $"mdl/props/global_access_panel_button/global_access_panel_button_console_w_stand.rmdl"

struct
{
	array< entity > entities
	array< entity > ziplineEntities
} file

void function ReMap_Init()
{
	PrecacheModel( REMAP_ZIPLINE_MODEL_ARM )
	PrecacheModel( REMAP_ZIPLINE_MODEL_SUPPORT )
	PrecacheModel( REMAP_ZIPLINE_MODEL_PANEL_WALL )
	PrecacheModel( REMAP_ZIPLINE_MODEL_PANEL_STAND )

	ReMap_Clear()
	ReMap_ClearZiplines()
	ReMap_LoadMap()
}

void function ReMap_Clear()
{
	foreach ( entity ent in file.entities )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}

	file.entities.clear()
}

entity function ReMap_CreateProp( asset model, vector origin, vector angles, float scale = 1.0, bool mantle = false, float fadeDistance = -1.0 )
{
	entity prop = CreatePropDynamic( model, origin, angles, SOLID_VPHYSICS, fadeDistance )
	prop.SetScriptName( "remap_prop" )
	prop.SetModelScale( scale )

	if ( mantle )
		prop.AllowMantle()

	file.entities.append( prop )
	return prop
}

void function ReMap_ClearZiplines()
{
	foreach ( entity ent in file.ziplineEntities )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}

	file.ziplineEntities.clear()
}

void function ReMap_CreateZipline( vector startOrigin, vector startAngles, vector endOrigin, vector endAngles, int startProfile = REMAP_ZIPLINE_END_ARM, int endProfile = REMAP_ZIPLINE_END_ARM, bool vertical = false, float width = 2.0, float speedScale = 1.0 )
{
	if ( startOrigin == endOrigin )
		return

	vector startCableOrigin = ReMap_CreateZiplineEndModel( startProfile, startOrigin, startAngles )
	vector endCableOrigin = ReMap_CreateZiplineEndModel( endProfile, endOrigin, endAngles )

	entity startPoint = CreateEntity( "zipline" )
	startPoint.kv.DetachEndOnSpawn = 0
	startPoint.kv.DetachEndOnUse = 0
	startPoint.kv.Material = "cable/zipline.vmt"
	startPoint.kv.scale = 1.0
	startPoint.kv.Width = width
	startPoint.kv.ZiplineAutoDetachDistance = 100.0
	startPoint.kv.ZiplineDropToBottom = 1
	startPoint.kv.ZiplineFadeDistance = -1.0
	startPoint.kv.ZiplineLengthScale = 1.0
	startPoint.kv.ZiplinePreserveVelocity = 0
	startPoint.kv.ZiplinePushOffInDirectionX = 1
	startPoint.kv.ZiplineSpeedScale = speedScale
	startPoint.kv.ZiplineVersion = 3
	startPoint.kv.ZiplineVertical = vertical
	startPoint.SetAngles( startAngles )
	startPoint.SetOrigin( startCableOrigin )

	entity endPoint = CreateEntity( "zipline_end" )
	endPoint.kv.ZiplineAutoDetachDistance = 100.0
	endPoint.kv.ZiplinePushOffInDirectionX = 1
	endPoint.SetAngles( endAngles )
	endPoint.SetOrigin( endCableOrigin )

	startPoint.LinkToEnt( endPoint )
	DispatchSpawn( startPoint )
	DispatchSpawn( endPoint )
	file.ziplineEntities.append( startPoint )
	file.ziplineEntities.append( endPoint )
}

vector function ReMap_CreateZiplineEndModel( int profile, vector origin, vector angles )
{
	if ( profile == REMAP_ZIPLINE_END_ARM )
	{
		entity arm = ReMap_CreateProp( REMAP_ZIPLINE_MODEL_ARM, origin, angles )
		int ropeAttachment = arm.LookupAttachment( "ATTACH_TOP_ROPE" )
		if ( ropeAttachment > 0 )
			return arm.GetAttachmentOrigin( ropeAttachment )
	}
	else if ( profile == REMAP_ZIPLINE_END_SUPPORT )
		ReMap_CreateProp( REMAP_ZIPLINE_MODEL_SUPPORT, origin, angles )
	else if ( profile == REMAP_ZIPLINE_END_PANEL_WALL )
		ReMap_CreateProp( REMAP_ZIPLINE_MODEL_PANEL_WALL, origin, angles )
	else if ( profile == REMAP_ZIPLINE_END_PANEL_STAND )
		ReMap_CreateProp( REMAP_ZIPLINE_MODEL_PANEL_STAND, origin, angles )

	return origin
}
