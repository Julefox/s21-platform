{
	#if SERVER
	DebugDrawBox( origin, mins, maxs, r, g, b, alpha, time )
	#elseif CLIENT
	DebugDrawBox( origin, mins, maxs, <r, g, b>, alpha, time )
	#endif
}

void function DebugDrawBoxColor( vector origin, vector mins, vector maxs, vector color, int alpha, float time )
{
	#if SERVER
	DebugDrawBox( origin, mins, maxs, int( color.x ), int( color.y ), int( color.z ), alpha, time )
	#elseif CLIENT
	DebugDrawBox( origin, mins, maxs, color, alpha, time )
	#endif
}

