globalize_all_functions

// Dual-arity: SERVER DebugDraw* takes r,g,b ints; CLIENT/UI takes vector color.
// Shared helpers with identical bodies stay unguarded below the role blocks.

// Dual-arity wrappers: S3 SERVER engine takes r,g,b ints; S21 CLIENT / S21 takes colorVec.
// Prefer *RGB / *Color helpers over bare engine DebugDraw* in shared scripts.
// Wrappers call engine natives only (never recurse).
#if SERVER || CLIENT

void function DebugDrawLineRGB( vector start, vector end, int r, int g, int b, bool noDepthTest, float duration )
{
	#if SERVER
	DebugDrawLine( start, end, r, g, b, noDepthTest, duration )
	#elseif CLIENT
	DebugDrawLine( start, end, <r, g, b>, noDepthTest, duration )
	#endif
}

void function DebugDrawLineColor( vector start, vector end, vector color, bool noDepthTest, float duration )
{
	#if SERVER
	DebugDrawLine( start, end, int( color.x ), int( color.y ), int( color.z ), noDepthTest, duration )
	#elseif CLIENT
	DebugDrawLine( start, end, color, noDepthTest, duration )
	#endif
}

