void function DrawTracerOverTime_Thread( vector origin, vector dir, float time )
{
	float frac
	float x
	float y
	float timeFrac
	float interval
	float lastInterval = 0.0

	int counter = 1

	while ( counter <= 10 )
	{
		frac = counter / 10.0
		x = 1 - frac
		y = x * x * x * x
		frac = 1 - y
		timeFrac = time * frac
		interval = timeFrac - lastInterval
		lastInterval = timeFrac

		DebugDrawLineRGB( origin, origin + dir * frac, int(COLOR_LIGHT_YELLOW.x), int(COLOR_LIGHT_YELLOW.y), int(COLOR_LIGHT_YELLOW.z), false, interval + 0.05 )
