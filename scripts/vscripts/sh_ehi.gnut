int function GetPlayerRankScoreFromEHI( EHI playerEHI )
{
	int rankScore = EHI_GetRankScore( playerEHI )

	return rankScore
}
#endif

#if SERVER || CLIENT
int function GetPlayerLadderPosFromEHI( EHI playerEHI )
{
	int rankScore = EHI_GetRankedLadderPos( playerEHI )

	return rankScore
}

