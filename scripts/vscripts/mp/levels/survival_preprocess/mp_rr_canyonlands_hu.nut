global function mp_rr_canyonlands_hu_SurvivalPreprocess
global function RunMySurvivalPreprocess

void function RunMySurvivalPreprocess()
{
	mp_rr_canyonlands_hu_SurvivalPreprocess()
}

void function mp_rr_canyonlands_hu_SurvivalPreprocess()
{
	if ( Dev_CommandLineHasParm( "-survival_preprocess" ) )
		return

	//Crypto TT Assets
	PrecacheModel( $"mdl/levels_terrain/mp_rr_canyonlands/crypto_holo_map_hu_01.rmdl" )
	PrecacheModel( $"mdl/levels_terrain/mp_rr_canyonlands/crypto_holo_map_hu_02.rmdl" )
	PrecacheModel( $"mdl/levels_terrain/mp_rr_canyonlands/crypto_holo_map_hu_03.rmdl" )
	PrecacheModel( $"mdl/levels_terrain/mp_rr_canyonlands/crypto_holo_map_hu_04.rmdl" )
	PrecacheModel( $"mdl/levels_terrain/mp_rr_canyonlands/crypto_holo_map_hu_05.rmdl" )

	PrecacheParticleSystem( $"P_holo_ar_radius_pc64_CP_1x20" )
	PrecacheParticleSystem( $"P_map_holo_ring_CP" )
	PrecacheParticleSystem( $"P_map_player_pt_enemy" )
	PrecacheParticleSystem( $"P_map_player_pt_team" )
	PrecacheParticleSystem( $"P_crypto_holo_sat_scan" )

	//Caustic TT Assets
	PrecacheParticleSystem( $"P_caustic_tt_geyser_idle" )
	PrecacheParticleSystem( $"P_caustic_tt_env_steam_slow" )
	PrecacheParticleSystem( $"P_caustic_tt_canister" )

	AddZone_0()
	AddZone_1()
	AddZone_2()
	AddZone_3()
