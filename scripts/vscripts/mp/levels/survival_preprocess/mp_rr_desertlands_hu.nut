global function mp_rr_desertlands_hu_SurvivalPreprocess
global function RunMySurvivalPreprocess

void function RunMySurvivalPreprocess()
{
	mp_rr_desertlands_hu_SurvivalPreprocess()
}

void function mp_rr_desertlands_hu_SurvivalPreprocess()
{
	if ( Dev_CommandLineHasParm( "-survival_preprocess" ) )
		return

	//Bloodhound TT Assets
	PrecacheModel( $"mdl/props/holo_spray/holo_spray_base.rmdl" )
	PrecacheModel( $"mdl/Creatures/prowler/prowler_apex.rmdl" )

	PrecacheParticleSystem( $"P_holo_bhtt_chargerifle" )
	PrecacheParticleSystem( $"P_prowler_hatch_light" )
	PrecacheParticleSystem( $"P_crow_door_alarm" )
	PrecacheParticleSystem( $"P_crow_door_room_light" )

	//Rampart TT Assets
	PrecacheModel( $"mdl/desertlands/rampart_tt_vendit_01_energyfield_01.rmdl" )

	PrecacheParticleSystem( $"P_rampart_vendit_shield_disable" )
	PrecacheParticleSystem( $"P_vault_door_alarm_oly_mu1_sm" )

	AddZone_0()
	AddZone_1()
	AddZone_2()
	AddZone_3()
	AddZone_4()
	AddZone_5()
	AddZone_6()
	AddZone_7()
