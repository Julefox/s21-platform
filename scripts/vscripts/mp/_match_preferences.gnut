global function MatchPreferences_Init

#if SERVER
global function ClientCallback_SetMatchPreferenceFlag
global function ClientCallback_ClearMatchPreferenceFlag
#endif

global enum eMatchPreferenceFlags
{
	LAST_SQUAD_INVITE_OPT_OUT			= (1 << 0)
	CROSSPLAY_INVITE_AUTO_DENY			= (1 << 1)
}

void function MatchPreferences_Init()
{
}

#if SERVER
void function ClientCallback_SetMatchPreferenceFlag( entity player, int flag )
{
	int updatedMatchPreferenceFlags = player.GetPersistentVarAsInt( "matchPreferences" ) | flag
	player.SetPersistentVar( "matchPreferences", updatedMatchPreferenceFlags )
}

void function ClientCallback_ClearMatchPreferenceFlag( entity player, int flag )
{
	int updatedMatchPreferenceFlags = player.GetPersistentVarAsInt( "matchPreferences" ) & ~flag
	player.SetPersistentVar( "matchPreferences", updatedMatchPreferenceFlags )
}
#endif // SERVER
