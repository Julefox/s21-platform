global const bool HAS_FORGE = false
global const bool HAS_FORGE_ABILITIES = (HAS_FORGE && true)
global const bool HAS_FORGE_ALT_SUPER = false
#if HAS_FORGE
global const string WEAPON_FORGE = "mp_ability_forge_gpound"
global const asset CHARACTER_FORGE = $"settings/player/mp/pilot_survival_rosie.rpak"
