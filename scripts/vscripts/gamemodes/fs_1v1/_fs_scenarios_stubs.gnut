// Scenarios (fs_scenarios) is not ported. Minimal types + stubs so fs_1v1 bodies compile.
// isScenariosMode() is false for playlist fs_1v1 -- runtime paths stay cold.
// SCENARIOS_MAX_ALLOWED_TEAMSIZE lives in sh_fs_1v1_helpers (loads first).

global struct scenariosTeamStruct
{
	array<entity> players
	int team
	int customTeamID = -1
}

global struct scenariosGroupStruct
{
	entity dummyEnt
	int groupHandle
	array<scenariosTeamStruct> teams
	LocationsData &groupLocStruct
	entity ring
	float currentRingRadius
	vector calculatedRingCenter
	int slotIndex
	bool IsFinished = false
	float startTime
	float endTime
	bool showedEndMsg = false
	bool isReady = false
	bool isValid = false
	array<entity> groundLoot
	array<entity> lootbins
	array<entity> doors
	int trackedEntsArrayIndex = -1
	float lastTimeRingDamagedGroup = 0
	bool isLastGameFromRound
	bool isForcedGame
}

global function FS_Scenarios_ForceRest
global function FS_Scenarios_GetInventoryEmptyEnabled
global function FS_Scenarios_GetPlayerToGroupMap
global function FS_Scenarios_GetScenariosTeamCount
global function FS_Scenarios_Main_Thread
global function FS_Scenarios_ReturnGroupForPlayer
global function FS_Scenarios_SetupPanels

struct
{
	table<int, scenariosGroupStruct> scenariosPlayerToGroupMap
	bool logged = false
} file

void function FS_Scenarios_LogOnce()
{
	if ( file.logged )
		return
	file.logged = true
	printt( "[FS-1V1] scenarios stubs active (fs_scenarios not ported)" )
}

void function FS_Scenarios_ForceRest( entity player )
{
	FS_Scenarios_LogOnce()
	// Fall back to normal 1v1 rest if scenarios path is ever hit.
	if ( IsValid( player ) )
		printt( "[FS-1V1] FS_Scenarios_ForceRest stub " + player.GetPlayerName() )
}

bool function FS_Scenarios_GetInventoryEmptyEnabled()
{
	return GetCurrentPlaylistVarBool( "fs_scenarios_inventory_empty", false )
}

table<int, scenariosGroupStruct> function FS_Scenarios_GetPlayerToGroupMap()
{
	return file.scenariosPlayerToGroupMap
}

int function FS_Scenarios_GetScenariosTeamCount()
{
	return GetCurrentPlaylistVarInt( "fs_scenarios_team_count", 2 )
}

void function FS_Scenarios_Main_Thread()
{
	FS_Scenarios_LogOnce()
	// no-op loop not started -- scenarios not ported
}

scenariosGroupStruct ornull function FS_Scenarios_ReturnGroupForPlayer( entity player )
{
	return null
}

void function FS_Scenarios_SetupPanels()
{
	FS_Scenarios_LogOnce()
}
