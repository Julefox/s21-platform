	// GLADIATOR CARD OVERLAY -- the client VM nests the real card into CardPanel's
	// "card" arg; everything here is just the modal chrome around it.

		CardDim
		{
			ControlName				Label
			xpos					0
			ypos					0
			wide					%100
			tall					%100
			labelText				""
			bgcolor_override		"0 0 0 214"
			paintbackground			1
			visible					0
			zpos					200
		}

		// mute_button draws nothing until an icon is handed to it, which makes it
		// the invisible full-screen surface that eats the click closing the card.
		// basic_image would paint an opaque white quad here.
		CardClickCatcher
		{
			ControlName				RuiButton
			xpos					0
			ypos					0
			wide					%100
			tall					%100
			visible					0
			enabled					1
			zpos					201
			rui						"ui/mute_button.rpak"
		}

