resource/ui/menus/FlowstateLeaderboard/fs_leaderboard.menu
{
	menu
	{
		ControlName				Frame
		xpos					0
		ypos					0
		zpos					3
		wide					f0
		tall					f0
		autoResize				0
		pinCorner				0
		visible					1
		enabled					1
		tabPosition				0
		PaintBackgroundType		0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"
		modal					1
		disableDpad             0

		// UpdateMenuBlur keys on a DIRECT child named ScreenBlur: without it the
		// menu is composited below the blur layer and its Labels stop painting.
		// The RUI is the whole board frame -- frosted glass, dark fill, header
		// band and edge bar, chamfered at the top-right -- so the engine menu
		// blur stays off and the world around the board renders sharp.
		ScreenBlur
		{
			ControlName				RuiPanel
			wide					980
			tall					692
			rui                     "ui/fs_lb_frame.rpak"
			visible					1
			zpos 					-1

			pin_to_sibling			DarkenBackground
			pin_corner_to_sibling	CENTER
			pin_to_sibling_corner	CENTER
		}

		// Full-screen, invisible: the anchor every centred element pins to.
		DarkenBackground
		{
			ControlName				Label
			xpos					0
			ypos					0
			wide					%100
			tall					%100
			labelText				""
			bgcolor_override		"0 0 0 0"
			visible					1
			paintbackground			1
		}

		// Board rect. Draws nothing; the frame RUI paints the board.
		MainFrame
		{
			ControlName				ImagePanel
			wide					980
			tall					692
			fillColor				"0 0 0 0"
			drawColor				"0 0 0 0"
			visible					1
			zpos					0

			pin_to_sibling			DarkenBackground
			pin_corner_to_sibling	CENTER
			pin_to_sibling_corner	CENTER
		}

